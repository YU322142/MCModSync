# Copy this file to the Minecraft game root as modsync.properties.
# Replace example.invalid with the HTTPS endpoint of your published v5 channel.
manifest=https://example.invalid/minecraft/channel/stable/mods-v5.json

# auto follows the operating-system language. zh_cn and en_us are also accepted.
language=auto

strict=true
requireManifest=true

# Optional server-managed resource pack channel.
syncResourcePacks=false
resourcePackManifest=https://example.invalid/minecraft/channel/stable/resourcepacks.txt

# Optional owned server-list synchronization.
syncServerList=false
serverListManifest=https://example.invalid/minecraft/channel/stable/serverlist.txt

connectTimeoutSeconds=15
requestTimeoutSeconds=300
fileOperationRetries=12

# Optional local-only maximum size in bytes. It cannot be forced by the publisher.
# maxFileBytes=2147483648
