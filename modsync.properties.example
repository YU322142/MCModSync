# 复制到游戏根目录并改名为 modsync.properties。
# 把 example.invalid 替换为你自己控制的直链。
manifest=https://example.invalid/mcmodsync/mods.txt

# 界面语言：auto 优先读取 Minecraft options.txt，其次跟随系统；也可固定为 zh_cn 或 en_us。
language=auto

# 仅 PojavLauncher、MCinaBox、FCL、Zalith Launcher 2 会判定为手机端。
# 如需手机端使用另一份清单，取消下一行注释；通常一份 v4 清单即可通过不兼容平台区分。
# mobileManifest=https://example.invalid/mcmodsync/mobile-mods.txt

# 不使用资源包同步时保持 false；启用后必须填写有效清单。
syncResourcePacks=false
resourcePackManifest=https://example.invalid/mcmodsync/resourcepacks.txt
# mobileResourcePackManifest=https://example.invalid/mcmodsync/mobile-resourcepacks.txt

# 不使用服务器列表同步时保持 false；启用后必须填写有效清单。
syncServerList=false
serverListManifest=https://example.invalid/mcmodsync/serverlist.txt

# 安全策略。requireManifest=false 会被拒绝。
strict=true
requireManifest=true

connectTimeoutSeconds=15
requestTimeoutSeconds=300
maxFileBytes=2147483648
fileOperationRetries=12
